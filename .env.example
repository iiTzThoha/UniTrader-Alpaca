# ============================================================
# Alpaca Hackathon Bot - Environment Variables
# Copy this file to ".env" and fill in your real values.
# NEVER commit the real ".env" file to git.
# ============================================================

# --- Alpaca Trading API (Paper) ---
# Get these from: app.alpaca.markets -> Profile/Account Settings -> API Keys
ALPACA_API_KEY=your_alpaca_key_id_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
# Paper trading base URL (do not change unless going live post-hackathon)
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# --- Supabase ---
# Get these from: supabase.com project -> Project Settings -> Data API
SUPABASE_URL=https://your-project-ref.supabase.co
# "Publishable" key (new name for "anon" key) - safe-ish, respects RLS
SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here
# "Secret" key (new name for "service_role" key) - full access, backend only!
SUPABASE_SECRET_KEY=your_secret_key_here

# --- LLM Provider: AI/ML API ---
# Single key, OpenAI-compatible endpoint, routes to many models by name.
# Get your key from: aimlapi.com dashboard
AIML_API_KEY=your_aiml_api_key_here
AIML_BASE_URL=https://api.aimlapi.com/v1
# Proposer and Critic use different model names for independence -
# exact valid model strings will be confirmed against AI/ML API docs on Day 3
PROPOSER_MODEL=gpt-4o
CRITIC_MODEL=anthropic/claude-sonnet-4.5

# --- App Config Overrides (optional, defaults live in config/settings.py) ---
# execution_mode: "manual" or "auto"
EXECUTION_MODE=manual
LOG_LEVEL=INFO
